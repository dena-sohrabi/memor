<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Used by `xcodebuild -exportArchive` to sign an archive for the App
     Store and upload it to App Store Connect (TestFlight). -->
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>2487AN8AL4</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<!-- Lets App Store Connect bump the build number, so every upload is accepted. -->
	<key>manageAppVersionAndBuildNumber</key>
	<true/>
</dict>
</plist>
